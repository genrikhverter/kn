+#!/usr/bin/env python3
+# -*- coding: utf-8 -*-
+# Патч интеграции: слот logistics закрывает LSfusion-прототип «Код Урожая»
+# через мост knp_bridge.
+
+from app.routes._proxy_factory import create_proxy_router
+
+router = create_proxy_router(
+    gateway_prefix="/api/v1/logistics",
+    service_name="lsfusion-bridge",
+    service_url_env="LSFUSION_BRIDGE_URL",
+    default_service_url="http://knp-bridge:8090",
+    backend_prefix="/api/v1/logistics",
+    tags=["logistics"],
+)
