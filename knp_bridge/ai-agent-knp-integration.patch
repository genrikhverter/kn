+
+    # --- Патч интеграции: инструменты LSfusion-прототипа через knp_bridge -------------
+
+    async def _bridge_get(self, path: str, params: dict | None = None, timeout: float = 20.0) -> dict | list | None:
+        """GET к мосту knp_bridge. None — сервис недоступен (не ошибка модели)."""
+        url = settings.lsfusion_bridge_url.rstrip("/") + path
+        try:
+            resp = await httpx.AsyncClient().get(url, params=params, timeout=timeout)
+        except httpx.HTTPError as e:
+            logger.warning("bridge unavailable: %s", e)
+            return None
+        if resp.status_code >= 400:
+            logger.warning("bridge %s -> HTTP %s", path, resp.status_code)
+            return None
+        return resp.json()
+
+    async def _get_budget_summary(self, year: int) -> ToolResult:
+        data = await self._bridge_get("/api/v1/economics/bdr", {"year": year})
+        if data is None:
+            return ToolResult(
+                data={"error": "Бюджетный контур (LSfusion) недоступен."},
+                grounded=False,
+            )
+        sources = [
+            ChatSource(type="budget", id=f"{row.get('plan')}/{row.get('scenario')}", label=f"{row.get('plan')} · {row.get('scenario')}")
+            for row in data
+        ]
+        return ToolResult(data={"year": year, "count": len(data), "budgets": data}, sources=sources)
+
+    async def _get_crop_pnl(self) -> ToolResult:
+        data = await self._bridge_get("/api/v1/economics/crop-pnl")
+        if data is None:
+            return ToolResult(data={"error": "Витрина P&L (LSfusion) недоступна."}, grounded=False)
+        sources = [ChatSource(type="crop", id=row.get("crop", ""), label=row.get("crop", "")) for row in data]
+        return ToolResult(data={"count": len(data), "crops": data}, sources=sources)
+
+    async def _get_npk_balance(self, field_code: str) -> ToolResult:
+        code = field_code.strip().upper()
+        data = await self._bridge_get("/api/v1/yield/npk", {"field": code})
+        if data is None:
+            return ToolResult(data={"error": "Агрохимический контур (LSfusion) недоступен."}, grounded=False)
+        if not data:
+            return ToolResult(data={"found": False, "field_code": code})
+        sources = [ChatSource(type="field", id=code, label=code)]
+        sources += [
+            ChatSource(type="nutrient", id=row.get("element", ""), label=row.get("element", ""))
+            for row in data
+        ]
+        return ToolResult(data={"field_code": code, "elements": data}, sources=sources)
+
+    async def _get_fields(self) -> ToolResult:
+        data = await self._bridge_get("/api/v1/ku/map/fields")
+        if data is None:
+            return ToolResult(data={"error": "Справочник полей (LSfusion) недоступен."}, grounded=False)
+        fields = [
+            dict(f.get("properties") or {}, coordinates=(f.get("geometry") or {}).get("coordinates"))
+            for f in data.get("features", [])
+        ]
+        sources = [ChatSource(type="field", id=f.get("code", ""), label=f.get("name", f.get("code", ""))) for f in fields]
+        return ToolResult(data={"count": len(fields), "fields": fields}, sources=sources)
