        NEW d = SeasonDay { sdDay(d) <- 144; sdDate(d) <- 2027_04_15 + 143; sdTemp(d) <- 17.3; }
        NEW d = SeasonDay { sdDay(d) <- 145; sdDate(d) <- 2027_04_15 + 144; sdTemp(d) <- 18.0; }
        NEW d = SeasonDay { sdDay(d) <- 146; sdDate(d) <- 2027_04_15 + 145; sdTemp(d) <- 18.7; }
        NEW d = SeasonDay { sdDay(d) <- 147; sdDate(d) <- 2027_04_15 + 146; sdTemp(d) <- 19.3; }
        NEW d = SeasonDay { sdDay(d) <- 148; sdDate(d) <- 2027_04_15 + 147; sdTemp(d) <- 19.7; }
        NEW d = SeasonDay { sdDay(d) <- 149; sdDate(d) <- 2027_04_15 + 148; sdTemp(d) <- 20.0; }
        NEW d = SeasonDay { sdDay(d) <- 150; sdDate(d) <- 2027_04_15 + 149; sdTemp(d) <- 20.0; }
