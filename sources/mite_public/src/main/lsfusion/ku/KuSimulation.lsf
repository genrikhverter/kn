        NEW d = SeasonDay { sdDay(d) <- 153; sdDate(d) <- 2027_04_15 + 152; sdTemp(d) <- 18.7; }
        NEW d = SeasonDay { sdDay(d) <- 154; sdDate(d) <- 2027_04_15 + 153; sdTemp(d) <- 18.0; }
        NEW d = SeasonDay { sdDay(d) <- 155; sdDate(d) <- 2027_04_15 + 154; sdTemp(d) <- 17.3; }
        NEW d = SeasonDay { sdDay(d) <- 156; sdDate(d) <- 2027_04_15 + 155; sdTemp(d) <- 16.7; }
        NEW d = SeasonDay { sdDay(d) <- 157; sdDate(d) <- 2027_04_15 + 156; sdTemp(d) <- 16.3; sdInHorizon(d) <- TRUE; }
        NEW d = SeasonDay { sdDay(d) <- 158; sdDate(d) <- 2027_04_15 + 157; sdTemp(d) <- 16.0; sdInHorizon(d) <- TRUE; }
        NEW d = SeasonDay { sdDay(d) <- 159; sdDate(d) <- 2027_04_15 + 158; sdTemp(d) <- 16.0; sdInHorizon(d) <- TRUE; }
        NEW d = SeasonDay { sdDay(d) <- 160; sdDate(d) <- 2027_04_15 + 159; sdTemp(d) <- 16.3; sdInHorizon(d) <- TRUE; }
        NEW d = SeasonDay { sdDay(d) <- 161; sdDate(d) <- 2027_04_15 + 160; sdTemp(d) <- 16.7; sdInHorizon(d) <- TRUE; }
        NEW d = SeasonDay { sdDay(d) <- 162; sdDate(d) <- 2027_04_15 + 161; sdTemp(d) <- 17.3; sdInHorizon(d) <- TRUE; }
        NEW d = SeasonDay { sdDay(d) <- 163; sdDate(d) <- 2027_04_15 + 162; sdTemp(d) <- 18.0; sdInHorizon(d) <- TRUE; }
        NEW d = SeasonDay { sdDay(d) <- 164; sdDate(d) <- 2027_04_15 + 163; sdTemp(d) <- 18.7; sdInHorizon(d) <- TRUE; }
        NEW d = SeasonDay { sdDay(d) <- 165; sdDate(d) <- 2027_04_15 + 164; sdTemp(d) <- 19.3; sdInHorizon(d) <- TRUE; }
        NEW d = SeasonDay { sdDay(d) <- 166; sdDate(d) <- 2027_04_15 + 165; sdTemp(d) <- 19.7; sdInHorizon(d) <- TRUE; }
        NEW d = SeasonDay { sdDay(d) <- 167; sdDate(d) <- 2027_04_15 + 166; sdTemp(d) <- 20.0; sdInHorizon(d) <- TRUE; }
        NEW d = SeasonDay { sdDay(d) <- 168; sdDate(d) <- 2027_04_15 + 167; sdTemp(d) <- 20.0; sdInHorizon(d) <- TRUE; }
        NEW d = SeasonDay { sdDay(d) <- 169; sdDate(d) <- 2027_04_15 + 168; sdTemp(d) <- 19.7; sdInHorizon(d) <- TRUE; }
        NEW d = SeasonDay { sdDay(d) <- 170; sdDate(d) <- 2027_04_15 + 169; sdTemp(d) <- 13.3; sdInHorizon(d) <- TRUE; }
        APPLY;
    }
    // метеонормы (КП05): умеренный климат Краснодарского края, мм/°C по месяцам
    IF NOT (GROUP MAX KuWeatherNorm w) THEN {
        NEW w = KuWeatherNorm { wnMonth(w) <- 1; tempAvg(w) <- -2.0; precipMm(w) <- 78.0; }
        NEW w = KuWeatherNorm { wnMonth(w) <- 2; tempAvg(w) <- -1.0; precipMm(w) <- 66.0; }
        NEW w = KuWeatherNorm { wnMonth(w) <- 3; tempAvg(w) <- 4.0; precipMm(w) <- 58.0; }
        NEW w = KuWeatherNorm { wnMonth(w) <- 4; tempAvg(w) <- 10.5; precipMm(w) <- 52.0; }
        NEW w = KuWeatherNorm { wnMonth(w) <- 5; tempAvg(w) <- 16.0; precipMm(w) <- 60.0; }
        NEW w = KuWeatherNorm { wnMonth(w) <- 6; tempAvg(w) <- 20.5; precipMm(w) <- 68.0; }
        NEW w = KuWeatherNorm { wnMonth(w) <- 7; tempAvg(w) <- 23.5; precipMm(w) <- 54.0; }
        NEW w = KuWeatherNorm { wnMonth(w) <- 8; tempAvg(w) <- 23.0; precipMm(w) <- 45.0; }
        NEW w = KuWeatherNorm { wnMonth(w) <- 9; tempAvg(w) <- 18.0; precipMm(w) <- 42.0; }
        NEW w = KuWeatherNorm { wnMonth(w) <- 10; tempAvg(w) <- 12.0; precipMm(w) <- 55.0; }
        NEW w = KuWeatherNorm { wnMonth(w) <- 11; tempAvg(w) <- 6.0; precipMm(w) <- 68.0; }
        NEW w = KuWeatherNorm { wnMonth(w) <- 12; tempAvg(w) <- 0.0; precipMm(w) <- 80.0; }
        APPLY;
    }
    IF NOT (GROUP MAX ModelCoeff m) THEN {
        NEW m = ModelCoeff { coeffCode(m) <- 'baseTempN'; coeffValue(m) <- 8.0; coeffDescription(m) <- 'Базовая температура, °C'; }
        NEW m = ModelCoeff { coeffCode(m) <- 'gddToHarvest'; coeffValue(m) <- 1150.0; coeffDescription(m) <- 'САТ до уборки (1150: календарь сезона набирает ~1209 GDD)'; }
        NEW m = ModelCoeff { coeffCode(m) <- 'biomassMaxT'; coeffValue(m) <- 12.0; coeffDescription(m) <- 'Макс. биомасса, т/га'; }
        NEW m = ModelCoeff { coeffCode(m) <- 'scnFertEffect'; coeffValue(m) <- 1.05; coeffDescription(m) <- 'Эффект удобрения/полива, множитель (этап 1)'; }
        NEW m = ModelCoeff { coeffCode(m) <- 'scnDroughtPerDayPct'; coeffValue(m) <- 1.2; coeffDescription(m) <- 'Потери за день засухи, % (этап 1)'; }
        APPLY;
    }
    // ядра моделей (этап 2) + коэффициенты GDW — идемпотентно по кодам
    //(отдельные IF NOT: на живой БД общий блок коэффициентов уже закрыт)
    IF NOT engineByCode('ENG-GDD') THEN NEW e = SimEngine {
        seCode(e) <- 'ENG-GDD'; seName(e) <- 'KuGDD-1.0 (градусо-дни)';
        seDescription(e) <- 'Эталонное ядро: прогресс вегетации по накопленным GDD календаря, биомасса пропорционально прогрессу'; }
    IF NOT engineByCode('ENG-GDW') THEN NEW e = SimEngine {
        seCode(e) <- 'ENG-GDW'; seName(e) <- 'KuGDW-2.0 (GDD + вода, DSSAT-класс)';
        seDescription(e) <- 'Суточный водно-тепловой баланс: ET0 по Хargreves (Ra/широта), Kc/Ks, WUE-биомасса, урожайность по индексу водной обеспеченности'; }
    IF NOT coeffByCode('wueKgHaMm') THEN NEW m = ModelCoeff { coeffCode(m) <- 'wueKgHaMm'; coeffValue(m) <- 25.0; coeffDescription(m) <- 'WUE ядра GDW, кг/га биомассы на мм ETa'; }
    IF NOT coeffByCode('awcMm') THEN NEW m = ModelCoeff { coeffCode(m) <- 'awcMm'; coeffValue(m) <- 170.0; coeffDescription(m) <- 'Доступная влага корнеобитаемого слоя, мм (GDW)'; }
    IF NOT coeffByCode('swStartFrac') THEN NEW m = ModelCoeff { coeffCode(m) <- 'swStartFrac'; coeffValue(m) <- 0.65; coeffDescription(m) <- 'Стартовый запас влаги, доля AWC (GDW)'; }
    IF NOT coeffByCode('diurnalRangeN') THEN NEW m = ModelCoeff { coeffCode(m) <- 'diurnalRangeN'; coeffValue(m) <- 9.0; coeffDescription(m) <- 'Типичная амплитуда Tmax−Tmin, °C (Хargreves GDW)'; }
    IF NOT coeffByCode('kcMid') THEN NEW m = ModelCoeff { coeffCode(m) <- 'kcMid'; coeffValue(m) <- 1.10; coeffDescription(m) <- 'Пиковый культурный коэффициент Kc (GDW)'; }
    APPLY;
    // Tbase развития по культурам (справочные; пусто → дефолт движка 4.0)
    FOR Crop c IS Crop AND code(c) = 'ЗЕР-001' AND NOT cropTBase(c) DO cropTBase(c) <- 3.0;   // пшеница озимая
    FOR Crop c IS Crop AND code(c) = 'ЗЕР-002' AND NOT cropTBase(c) DO cropTBase(c) <- 3.0;   // ячмень
    FOR Crop c IS Crop AND code(c) = 'ЗЕР-003' AND NOT cropTBase(c) DO cropTBase(c) <- 8.0;   // кукуруза
    FOR Crop c IS Crop AND code(c) = 'ЗЕР-004' AND NOT cropTBase(c) DO cropTBase(c) <- 7.0;   // соя
    FOR Crop c IS Crop AND code(c) = 'ЗЕР-005' AND NOT cropTBase(c) DO cropTBase(c) <- 3.0;   // рожь
    FOR Crop c IS Crop AND code(c) = 'ЗЕР-006' AND NOT cropTBase(c) DO cropTBase(c) <- 3.0;   // овёс
    FOR Crop c IS Crop AND code(c) = 'ЗЕР-007' AND NOT cropTBase(c) DO cropTBase(c) <- 7.0;   // гречиха
    FOR Crop c IS Crop AND code(c) = 'БОБ-001' AND NOT cropTBase(c) DO cropTBase(c) <- 4.5;   // горох
    FOR Crop c IS Crop AND code(c) = 'ОВО-001' AND NOT cropTBase(c) DO cropTBase(c) <- 6.0;   // картофель
    FOR Crop c IS Crop AND code(c) = 'ОВО-002' AND NOT cropTBase(c) DO cropTBase(c) <- 8.0;   // томат
    APPLY;
    IF NOT (GROUP MAX StressType s) THEN {
        NEW s = StressType { stName(s) <- 'Засуха'; stDescription(s) <- 'Дефицит влаги'; }
        NEW s = StressType { stName(s) <- 'Заморозок'; stDescription(s) <- 'Низкие температуры'; }
        NEW s = StressType { stName(s) <- 'Дефицит азота'; stDescription(s) <- 'N ниже нормы'; }
        NEW s = StressType { stName(s) <- 'Вредители'; stDescription(s) <- 'Поражение вредителями'; }
        NEW s = StressType { stName(s) <- 'Болезни'; stDescription(s) <- 'Поражение болезнями'; }
        APPLY;
    }
    IF NOT (GROUP MAX StressType st IF stName(st) = 'Немоделируемый фактор') THEN {
        NEW st = StressType { stName(st) <- 'Немоделируемый фактор'; stDescription(st) <- 'Причина не определяется моделью — ручной анализ (ТЗ 4.2.2.2)'; }
        APPLY;
    }
    // базовая задача по KH-001 (пшеница): выполнена с результатом
    IF NOT (GROUP MAX SimTask t) AND northSim() AND wheatSim() AND currentCrop(northSim()) THEN {
        NEW t = SimTask { simField(t) <- northSim(); horizonDays(t) <- 90; simStatus(t) <- SimTaskStatus.done; simFinishedAt(t) <- currentDateTime(); }
        APPLY;
        NEW r = SimResult {
            simTask(r) <- GROUP MAX SimTask t IF simField(t) = northSim();
            resultCrop(r) <- currentCrop(northSim());
            resultHorizon(r) <- 90;
            forecastKind(r) <- ForecastKind.basic;
        }
        APPLY;
        FOR SimResult r IS SimResult AND forecastKind(r) = ForecastKind.basic
            AND simField(simTask(r)) = northSim()
        DO {
            makeDailySeason(r, 1.0, 0.0);
        }
        APPLY;
    }
    // сценарий «Засуха 14 дней» (выполнен, результат связан)
    IF NOT (GROUP MAX ScenarioRun sr) AND northSim() AND currentCrop(northSim()) THEN {
        NEW sr = ScenarioRun {
            srField(sr) <- northSim();
            scenarioKind(sr) <- ScenarioKind.drought;
            srDays(sr) <- 14;
            srStartDate(sr) <- 2027_06_15;
        }
        APPLY;
    }
    // дочинка: сценарии без результата выполняются (идемпотентно)
    FOR ScenarioRun sr IS ScenarioRun
        AND (srStatus(sr) = SimTaskStatus.queued OR srStatus(sr) = SimTaskStatus.processing)
        AND NOT srResult(sr)
    DO runScenario(sr);
    APPLY;
    // ФТ2.6 (демо): факт-NDVI последней точки базового результата KH-001 ниже
    // эталона на ~28% — материал для демонстрации автовыявления стресса
    FOR SimResult r IS SimResult AND forecastKind(r) = ForecastKind.basic
        AND simField(simTask(r)) = northSim()
    DO {
        FOR SimResultPoint p IS SimResultPoint AND pointDate(p) = lastPointDate(r) AND ndvi(p) AND NOT factNdvi(p) DO
            factNdvi(p) <- ndvi(p) * 0.72;
    }
    APPLY;
}

// ===================== Актуализация внешних данных (идемпотентно) =====================
externalDataSeed () {
    IF NOT kuExternalSource() THEN {
        // 1) метеонормы — реальные нормы ст. Петропавловск-35779 (1991–2020)
        FOR KuWeatherNorm n DO {
            tempAvg(n) <- petropavlTemp(wnMonth(n));
            precipMm(n) <- petropavlPrecip(wnMonth(n));
        }
        IF NOT kuRainThreshold() THEN kuRainThreshold() <- 50;
        // 2) календарь сезона — температуры по нормам (вместо демо-значений);
        //    живые данные подключит refreshSeasonWeather (после фетча прогноза)
        FOR SeasonDay d DO {
            sdTemp(d) <- roundS1(seasonTemp(sdDate(d)));
            sdLive(d) <- NULL;
        }
        // 3) погодные точки: по одной на организацию (координаты первого поля),
        //    привязка всех полей организации к точке
        FOR Organization o IS Organization
            AND (GROUP MAX Field f IF organization(f) = o AND centerLat(f))
            AND NOT locationByCode('WX-' + name(o))
        DO {
            LOCAL loc = Location ();
            NEW l = Location {
                name(l) <- 'Метеоточка ' + name(o);
                code(l) <- 'WX-' + name(o);
                latitude(l) <- centerLat(GROUP MAX Field f IF organization(f) = o AND centerLat(f));
                longitude(l) <- centerLon(GROUP MAX Field f IF organization(f) = o AND centerLon(f));
                loc() <- l;
            }
            FOR Field f IS Field AND organization(f) = o DO location(f) <- loc();
        }
        // 4) базовые прогнозы для всех полей с культурой (если ещё нет активных)
        FOR Field f IS Field AND currentCrop(f)
            AND NOT (GROUP MAX 1 IF resultStatus(SimResult r) = SimResultStatus.active
                AND forecastKind(r) = ForecastKind.basic AND simField(simTask(r)) = f)
        DO NEW t = SimTask {
            simField(t) <- f;
            simTaskKind(t) <- SimTaskKind.planned;
            horizonDays(t) <- 90;
        }
        APPLY;
        FOR SimTask t IS SimTask AND simStatus(t) = SimTaskStatus.queued DO
            TRY {
                NEWSESSION {
                    runSimTask(t);
                }
            } CATCH {
                NEWSESSION {
                    simStatus(t) <- SimTaskStatus.error;
                    simError(t) <- messageCaughtException();
                    APPLY;
                }
            }
        // 5) фактический NDVI: открытых анонимных источников нет (Sentinel-2
        //    требует регистрации) — правдоподобная оценка по косвенным
        //    признакам: эталон × плавная вариация по фазе сезона
        //    (KH-001 — демо-стресс, не трогаем)
        FOR SimResult r IS SimResult AND resultStatus(r) = SimResultStatus.active
            AND forecastKind(r) = ForecastKind.basic
            AND code(simField(simTask(r))) != 'KH-001'
        DO FOR SimResultPoint p IS SimResultPoint AND result(p) = r AND ndvi(p) AND NOT factNdvi(p) DO
            factNdvi(p) <- roundS3(ndvi(p) * (0.93 + 0.09 * extractDay(pointDate(p)) / 30.0));
        kuExternalSource() <- 'метео: нормы 1991-2020 по г.Омск (ВНИИГМИ-МЦД); NDVI: модельная оценка по косвенным признакам';
        APPLY;
    }
}

